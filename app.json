{
  "name": "Universal Downloader Bot",
  "description": "A powerful Telegram bot that downloads videos and files from various platforms with high speed and DRM support",
  "repository": "https://github.com/Piyushmeena11/universal-downloader-bot",
  "logo": "https://raw.githubusercontent.com/Piyushmeena11/universal-downloader-bot/main/assets/logo.png",
  "keywords": [
    "telegram",
    "bot",
    "downloader",
    "youtube",
    "instagram",
    "tiktok",
    "facebook",
    "twitter",
    "video",
    "download",
    "python"
  ],
  "website": "https://github.com/Piyushmeena11/universal-downloader-bot",
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "required": true
    },
    "APP_URL": {
      "description": "Your Heroku App URL (without trailing slash)",
      "required": true
    },
    "LOG_CHANNEL_ID": {
      "description": "Telegram Channel ID for logs",
      "value": "-1002700476218",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Your bot's username without @",
      "required": false
    },
    "MAX_FILE_SIZE": {
      "description": "Maximum file size in bytes (default: 2GB)",
      "value": "2147483648",
      "required": false
    },
    "DOWNLOAD_PATH": {
      "description": "Download directory path",
      "value": "downloads",
      "required": false
    },
    "MAX_CONCURRENT_DOWNLOADS": {
      "description": "Maximum concurrent downloads",
      "value": "3",
      "required": false
    },
    "ADMIN_USER_ID": {
      "description": "Your Telegram User ID for admin access",
      "value": "8111983469",
      "required": false
    },
    "DEBUG_MODE": {
      "description": "Enable debug mode",
      "value": "false",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    }
  ],
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ]
}
